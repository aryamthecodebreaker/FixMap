+const IDENTIFIER_WEIGHT = 6;
+
+/**
+ * Two-pointer scan over line windows that fit the allowance. Each window scores the distinct
+ * identifiers (weighted) and distinct terms it contains, so a region where several task words
+ * meet beats one line that repeats a single word. Ties keep the earliest window. Returns
+ * undefined when no line matches anything.
+ */
+function densestWindow(
+  lines: readonly string[],
+  terms: readonly string[],
+  identifiers: readonly string[],
+  allowance: number,
+  anchor: number
+): { start: number; end: number } | undefined {
+  const keys = [
+    ...identifiers.map((identifier) => ({ key: `i:${identifier.toLowerCase()}`, needle: identifier.toLowerCase(), weight: IDENTIFIER_WEIGHT })),
+    ...terms.map((term) => ({ key: `t:${term.toLowerCase()}`, needle: term.toLowerCase(), weight: 1 }))
+  ].filter((entry, index, all) => entry.needle.length > 0 && all.findIndex((other) => other.key === entry.key) === index);
+  if (keys.length === 0) return undefined;
+  const matches = lines.map((line) => {
+    const lower = line.toLowerCase();
+    return keys.filter((entry) => lower.includes(entry.needle));
+  });
+  if (!matches.some((entry) => entry.length > 0)) return undefined;
+  const lineTokens = lines.map((line) => estimateContextTokens(`${line}\n`));
+  const counts = new Map<string, number>();
+  let score = 0;
+  let tokens = 0;
+  let end = -1;
+  let best: { start: number; end: number; score: number } | undefined;
+  for (let start = 0; start < lines.length; start += 1) {
+    while (end + 1 < lines.length && tokens + lineTokens[end + 1]! <= allowance) {
+      end += 1;
+      tokens += lineTokens[end]!;
+      for (const entry of matches[end]!) {
+        const count = counts.get(entry.key) ?? 0;
+        if (count === 0) score += entry.weight;
+        counts.set(entry.key, count + 1);
+      }
+    }
+    // The strongest single line (usually the key identifier) must stay in the excerpt.
+    if (end >= start && start <= anchor && end >= anchor && score > 0 && (!best || score > best.score)) best = { start, end, score };
+    if (end >= start) {
+      tokens -= lineTokens[start]!;
+      for (const entry of matches[start]!) {
+        const count = counts.get(entry.key)! - 1;
+        counts.set(entry.key, count);
+        if (count === 0) score -= entry.weight;
+      }
+    } else {
+      end = start;
+    }
+  }
+  return best ? { start: best.start, end: best.end } : undefined;
+}
