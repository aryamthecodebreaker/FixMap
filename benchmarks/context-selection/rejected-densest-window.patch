@@ -0,0 +1,52 @@
+import { describe, expect, it } from "vitest";
+import { buildContextPack } from "../src/context.js";
+import type { FixMapReport, RepoFile, RepoMap } from "../src/types.js";
+
+function file(path: string, text: string): RepoFile {
+  return { path, extension: ".ts", sizeBytes: text.length, isSource: true, isTest: false, kind: "code", textSample: text, textSampleComplete: true };
+}
+
+function pack(text: string, task: string, budget: number) {
+  const repo: RepoMap = { root: "/r", files: [file("src/session.ts", text)], packageScripts: [], changedFiles: [], diffText: "", packageManager: "npm", diagnostics: [] };
+  const report: FixMapReport = {
+    summary: "s", testRoutes: [], risks: [], changedFiles: [], diagnostics: [],
+    contextFiles: [{ rank: 1, path: "src/session.ts", score: 1, confidence: "high", reasons: ["task match"] }]
+  };
+  return buildContextPack({ report, repo, task, budgetTokens: budget });
+}
+
+const filler = (count: number, label: string) => Array.from({ length: count }, (_, index) => `const ${label}${index} = ${index}; // unrelated padding line`);
+
+describe("context excerpt selection", () => {
+  it("prefers the region where several task identifiers meet over a lone early mention", () => {
+    const text = [
+      "// refreshSession is documented elsewhere",
+      ...filler(80, "a"),
+      "export function refreshSession(token: string) {",
+      "  const expiry = computeExpiry(token);",
+      "  return renewToken(token, expiry);",
+      "}",
+      ...filler(80, "b")
+    ].join("\n");
+    const snippet = pack(text, "refreshSession should call renewToken with computeExpiry", 160).snippets[0]!;
+    const lines = text.split("\n");
+    const definition = lines.indexOf("export function refreshSession(token: string) {") + 1;
+    expect(snippet.startLine).toBeLessThanOrEqual(definition);
+    expect(snippet.endLine).toBeGreaterThanOrEqual(definition + 2);
+    expect(snippet.content).toContain("renewToken(token, expiry)");
+    expect(snippet.estimatedTokens).toBeLessThanOrEqual(64);
+  });
+
+  it("keeps whole small files and stays within budget for large ones", () => {
+    expect(pack("export const x = 1;\n", "x", 1_000).snippets[0]).toMatchObject({ startLine: 1, endLine: 1 });
+    const big = [...filler(400, "c"), "export function target() {}", ...filler(400, "d")].join("\n");
+    const result = pack(big, "target", 200);
+    expect(result.estimatedSourceTokens).toBeLessThanOrEqual(200);
+    expect(result.snippets[0]!.content).toContain("export function target() {}");
+  });
+
+  it("falls back to the top of the file when nothing matches", () => {
+    const text = filler(300, "e").join("\n");
+    expect(pack(text, "nothing here matches", 200).snippets[0]!.startLine).toBe(1);
+  });
+});
