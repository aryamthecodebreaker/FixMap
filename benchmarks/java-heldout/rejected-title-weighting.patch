diff --git a/packages/core/test/title-weighting.test.ts b/packages/core/test/title-weighting.test.ts
new file mode 100644
index 0000000..5b77667
--- /dev/null
+++ b/packages/core/test/title-weighting.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from "vitest";
+import { buildRetrievalQuery, rankDocumentsByBm25, taskTitle, TITLE_TERM_WEIGHT } from "../src/retrieval.js";
+
+describe("issue-title term weighting", () => {
+  it("reads a title only when a body follows it", () => {
+    expect(taskTitle("Failed to restore switch over string\n\nStack trace:\n at Foo.bar")).toBe("Failed to restore switch over string");
+    expect(taskTitle("\n\n  Title after blank lines  \nbody")).toBe("Title after blank lines");
+    expect(taskTitle("one line only")).toBeUndefined();
+    expect(taskTitle("title\n\n   \n")).toBeUndefined();
+    expect(taskTitle("")).toBeUndefined();
+  });
+
+  it("weights title terms (and their expansions) only when the issue text is given as the title source", () => {
+    const task = "Config loader crashes\n\nThe parser throws NullPointerException in Loader when reading values";
+    expect(buildRetrievalQuery(task).titleTerms).toEqual([]);
+    const weighted = buildRetrievalQuery(task, task);
+    expect(weighted.titleTerms.sort()).toEqual(["config", "configuration", "crashes", "crashe", "loader"].filter((term) => weighted.terms.includes(term)).sort());
+    expect(weighted.titleTerms).not.toContain("parser");
+    expect(TITLE_TERM_WEIGHT).toBe(2);
+  });
+
+  it("lets two title matches outrank three body-only matches, which win without weighting", () => {
+    const issue = "Switch string broken\n\nstack frame handler region";
+    const documents = [
+      { id: "SwitchStringVisitor", text: "switch string visitor" },
+      { id: "FrameHandler", text: "frame handler region" },
+      { id: "Unrelated", text: "logging output format" }
+    ];
+    expect(rankDocumentsByBm25(documents, issue, 3)[0]?.id).toBe("FrameHandler");
+    expect(rankDocumentsByBm25(documents, issue, 3, issue)[0]?.id).toBe("SwitchStringVisitor");
+  });
+
+  it("never treats a diff's first line as a title", () => {
+    const task = ["fix loader", "diff --git a/src/Loader.java b/src/Loader.java\n+ value"].join("\n");
+    expect(buildRetrievalQuery(task, "fix loader").titleTerms).toEqual([]);
+    expect(buildRetrievalQuery(task, undefined).titleTerms).toEqual([]);
+  });
+
+  it("ranks one-line tasks exactly as before", () => {
+    const documents = [
+      { id: "a", text: "alpha beta gamma" },
+      { id: "b", text: "beta beta delta" },
+      { id: "c", text: "gamma delta epsilon" }
+    ];
+    const task = "beta gamma delta";
+    expect(rankDocumentsByBm25(documents, task, 3, task)).toEqual(rankDocumentsByBm25(documents, task, 3));
+  });
+});
