+/**
+ * Issue titles name the problem; bodies add logs, stack traces and environment detail. Treating
+ * every word once made a long body drown the title (a Java crash report titled after the class
+ * that failed never reached the lexical top 50). Title terms count twice when a body exists;
+ * one-line tasks are unchanged because every term is a title term.
+ */
+export const TITLE_TERM_WEIGHT = 2;
+
+/** The first non-empty line, when more non-empty text follows it. */
+export function taskTitle(task: string): string | undefined {
+  const lines = task.split(/\r?\n/);
+  const index = lines.findIndex((line) => line.trim().length > 0);
+  if (index === -1) return undefined;
+  const rest = lines.slice(index + 1).join("\n").trim();
+  return rest ? lines[index]!.trim() : undefined;
+}
